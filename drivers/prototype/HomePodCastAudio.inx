; HomePodCast development driver. MIT license. Unsigned until test signing.
[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/26/2026,0.1.0.0
CatalogFile=HomePodCastAudio.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Models,NT$ARCH$.10.0...22621
[Models.NT$ARCH$.10.0...22621]
%DeviceName%=Install,Root\HomePodCastAudio

[SourceDisksNames]
1=%DiskName%,,,
[SourceDisksFiles]
HomePodCastAudio.sys=1
[DestinationDirs]
DriverCopy=13
[DriverCopy]
HomePodCastAudio.sys

[Install.NT]
CopyFiles=DriverCopy
[Install.NT.Services]
AddService=HomePodCastAudio,0x00000002,Service
[Service]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\HomePodCastAudio.sys
[Install.NT.Wdf]
KmdfService=HomePodCastAudio,Wdf
[Wdf]
KmdfLibraryVersion=$KMDFVERSION$
[Install.NT.HW]
AddReg=Hardware
[Hardware]
HKR,,DeviceType,0x10001,0x1d
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"
HKR,Parameters,DoNotCreateDataFiles,0x10001,1

[Install.NT.Interfaces]
AddInterface=%Audio%,"WaveHomePodCast",Wave
AddInterface=%Render%,"WaveHomePodCast",Wave
AddInterface=%Realtime%,"WaveHomePodCast",Wave
AddInterface=%Audio%,"TopologyHomePodCast",Topology
AddInterface=%TopologyCategory%,"TopologyHomePodCast",Topology
[Wave]
AddReg=WaveProperties
[WaveProperties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%DeviceName%
[Topology]
AddReg=TopologyProperties
[TopologyProperties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%DeviceName%
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x10001,1
HKR,EP\0,%EndpointName%,,%DeviceName%

[Strings]
Provider="HomePodCast"
DeviceName="HomePodCast Audio"
DiskName="HomePodCast Audio development driver"
Proxy="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
Audio="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
Render="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
Realtime="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
TopologyCategory="{DDA54A40-1E4C-11D1-A050-405705C10000}"
AnyNode="{00000000-0000-0000-0000-000000000000}"
Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
EventDriven="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
EndpointName="{A45C254E-DF1C-4EFD-8020-67D146A850E0},14"
